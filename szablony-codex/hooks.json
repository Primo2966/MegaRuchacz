{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat \"{{PROJEKT}}/.megaruchacz/zasady-sesja.json\"",
            "commandWindows": "powershell -NoProfile -NonInteractive -Command \"Get-Content -Raw -LiteralPath '{{PROJEKT}}/.megaruchacz/zasady-sesja.json'\"",
            "timeout": 10,
            "statusMessage": "MegaRuchacz: zasady kierownika",
            "additionalContextLimit": 24000
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"{{ZRODLO}}/narzedzia/straznik-zasad.ps1\" -KosztCodex -Zrodlo \"{{ZRODLO}}\" -Projekt \"{{PROJEKT}}\"",
            "commandWindows": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"{{ZRODLO}}/narzedzia/straznik-zasad.ps1\" -KosztCodex -Zrodlo \"{{ZRODLO}}\" -Projekt \"{{PROJEKT}}\"",
            "timeout": 10,
            "statusMessage": "MegaRuchacz: rachunek za pamiec agenta",
            "additionalContextLimit": 1000
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"{{ZRODLO}}/narzedzia/straznik-zasad.ps1\" -Tlo -Zrodlo \"{{ZRODLO}}\" -Projekt \"{{PROJEKT}}\" >/dev/null 2>&1 || true",
            "commandWindows": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"{{ZRODLO}}/narzedzia/straznik-zasad.ps1\" -Tlo -Zrodlo \"{{ZRODLO}}\" -Projekt \"{{PROJEKT}}\"",
            "timeout": 300,
            "async": true,
            "statusMessage": "MegaRuchacz: samoaktualizacja narzedzia"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat \"{{PROJEKT}}/.megaruchacz/przypomnienie.json\"",
            "commandWindows": "powershell -NoProfile -NonInteractive -Command \"Get-Content -Raw -LiteralPath '{{PROJEKT}}/.megaruchacz/przypomnienie.json'\"",
            "timeout": 5,
            "statusMessage": "MegaRuchacz: przypomnienie",
            "additionalContextLimit": 1500
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{ZRODLO}}/narzedzia/mr-log-codex.js\" start \"{{PROJEKT}}\"",
            "commandWindows": "node \"{{ZRODLO}}/narzedzia/mr-log-codex.js\" start \"{{PROJEKT}}\"",
            "timeout": 5,
            "statusMessage": "MegaRuchacz: wpis do rejestru pracy"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{ZRODLO}}/narzedzia/mr-log-codex.js\" stop \"{{PROJEKT}}\"",
            "commandWindows": "node \"{{ZRODLO}}/narzedzia/mr-log-codex.js\" stop \"{{PROJEKT}}\"",
            "timeout": 5,
            "statusMessage": "MegaRuchacz: wpis do rejestru pracy"
          }
        ]
      }
    ]
  }
}
